# ============================================================
#  EDU YODHA — Backend Environment Variables
#
#  ⚠️  THIS FILE IS IN .gitignore — NEVER commit it to GitHub.
#
#  INSTRUCTIONS:
#  1. Copy this file: cp .env.example .env
#  2. Fill in your real values below.
#  3. On AWS: set these as EC2 environment variables or
#     store in AWS Secrets Manager / Parameter Store.
# ============================================================

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
# Get this from: MongoDB Atlas → Cluster0 → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://sangappaa92_db_user:<YOUR_PASSWORD_HERE>@cluster0.XXXXX.mongodb.net/

# Database name (must match your Atlas database)
DB_NAME=eduyodha

# JWT secret key — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<GENERATE_A_STRONG_SECRET_HERE>

# JWT token expiry
JWT_EXPIRES_IN=7d

# Server port (AWS will usually inject PORT automatically)
PORT=5000

# Environment
NODE_ENV=development
